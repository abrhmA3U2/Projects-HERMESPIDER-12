// =====================================================================// SECTION 3: SUB-MCU (STM32H7) CORE LOCOMOTION & DATA LINK (C++)// =====================================================================#include "stm32h7xx.h"#include <stdint.h>#include <string.h>
#define MAX_TORQUE_CURRENT 4000  #define ADDR_FDCAN_MSG_RAM 0x4000A000UL #define FDCAN_RAM_SIZE_PER_BUS 0x200 #define OVERRIDE_RESET_TOKEN 0x99999999
alignas(32) typedef struct {
    uint32_t Header;
    uint8_t  Data[8];
} FDCAN_TxBuffer_t;
alignas(32) volatile FDCAN_TxBuffer_t g_FDCAN_PingPongBuffer[4][2]; volatile uint8_t g_CurrentBufferSide = 0;      volatile uint16_t g_LegDifferentialVitals[12]; 
typedef struct {
    volatile uint8_t ground_states[12];
    volatile uint8_t sub_cpu_alerts[4];
} HermesSystemStatus_t;
volatile HermesSystemStatus_t g_SystemStatus;
void HA_FDCAN_MessageRAM_Config(void) {
    /* [SILICON PATCH 1] Partitioning Message RAM to eliminate SRAM write conflict locks */
    FDCAN1_CONFIG->MRBA = ADDR_FDCAN_MSG_RAM + (0 * FDCAN_RAM_SIZE_PER_BUS);
    FDCAN2_CONFIG->MRBA = ADDR_FDCAN_MSG_RAM + (1 * FDCAN_RAM_SIZE_PER_BUS);
    FDCAN3_CONFIG->MRBA = ADDR_FDCAN_MSG_RAM + (2 * FDCAN_RAM_SIZE_PER_BUS);
    FDCAN4_CONFIG->MRBA = ADDR_FDCAN_MSG_RAM + (3 * FDCAN_RAM_SIZE_PER_BUS);
    
    for(int i = 0; i < 4; i++) {
        uint32_t* pOffset = (uint32_t*)(ADDR_FDCAN_MSG_RAM + (i * FDCAN_RAM_SIZE_PER_BUS));
        *pOffset = 0x00000000; 
    }
}
void HA_ADC_Dephase_Init(void) {
    /* [SILICON PATCH 2] De-phase Drive configuration to eliminate internal chip cross-talk */
    ADC12_COMMON->CCR &= ~(ADC_CCR_DUAL | ADC_CCR_DELAY);
    ADC12_COMMON->CCR |= (0x3UL << ADC_CCR_DELAY_Pos); 
    ADC3_COMMON->CCR |= (0x1UL << ADC_CCR_DELAY_Pos);
    
    ADC1->CR |= ADC_CR_ADCAL; while(ADC1->CR & ADC_CR_ADCAL);
    ADC2->CR |= ADC_CR_ADCAL; while(ADC2->CR & ADC_CR_ADCAL);
    ADC3->CR |= ADC_CR_ADCAL; while(ADC3->CR & ADC_CR_ADCAL);
    
    ADC1->CR |= ADC_CR_ADEN; ADC2->CR |= ADC_CR_ADEN; ADC3->CR |= ADC_CR_ADEN;
}
extern "C" void TIM2_IRQHandler(void) {
    if (TIM2->SR & TIM_SR_UIF) {
        TIM2->SR = ~TIM_SR_UIF; 
        
        g_LegDifferentialVitals[0] = ADC1->DR; 
        g_LegDifferentialVitals[1] = ADC2->DR; 
        
        for(int i = 0; i < 12; i++) {
            g_SystemStatus.ground_states[i] = (g_LegDifferentialVitals[i] >= 2048) ? 1 : 0;
        }
        
        uint8_t next_side = g_CurrentBufferSide ^ 1;
        
        for (int group = 0; group < 4; group++) {
            int base_leg = group * 3;
            if (g_SystemStatus.ground_states[base_leg] == 0) { 
                g_SystemStatus.sub_cpu_alerts[group] = 1;      
                g_FDCAN_PingPongBuffer[group][next_side].Header = 0x100; 
                uint16_t safety_torque = MAX_TORQUE_CURRENT * 1.5;
                memcpy((void*)&g_FDCAN_PingPongBuffer[group][next_side].Data[0], &safety_torque, 2);
            } else {
                g_SystemStatus.sub_cpu_alerts[group] = 0; 
                g_FDCAN_PingPongBuffer[group][next_side].Header = 0x200; 
                uint16_t normal_torque = MAX_TORQUE_CURRENT;
                memcpy((void*)&g_FDCAN_PingPongBuffer[group][next_side].Data[0], &normal_torque, 2);
            }
        }
        
        g_CurrentBufferSide = next_side; 
        
        /* [SILICON PATCH 3] Cache Clean/Flush right before non-blocking MDMA burst firing */
        SCB_CleanDCache_by_Addr((uint32_t*)&g_FDCAN_PingPongBuffer[g_CurrentBufferSide][0], sizeof(FDCAN_TxBuffer_t) * 4);
        
        MDMA_Channel0->CCR &= ~MDMA_CCR_EN;
        MDMA_Channel0->CSAR = (uint32_t)&g_FDCAN_PingPongBuffer[g_CurrentBufferSide][0];
        MDMA_Channel0->CDAR = (uint32_t)&(FDCAN1_CONFIG->TXBAR); 
        MDMA_Channel0->CCR |= MDMA_CCR_EN;                       
        
        IWDG->KR = 0xAAAA; // Feed independent watchdog
    }
}
